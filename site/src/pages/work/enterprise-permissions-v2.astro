---
/**
 * Enterprise Permissions case study - v2 rebuild (docs/PERMISSIONS-REBUILD.md).
 * Working copy; live page remains enterprise-permissions.astro.
 */
import CaseStudy from '../../layouts/CaseStudy.astro';
import AnnotationFigure from '../../components/AnnotationFigure.astro';
import { cases } from '../../data/cases';

const c = cases.find((x) => x.slug === 'enterprise-permissions')!;
const next = cases.find((x) => x.slug === 'myintake')!;

const groupTaxonomy = [
  { name: 'Dynamic', when: 'Launch · default', text: 'Membership from attribute rules, e.g. all People Managers. Updates save immediately, membership syncs overnight.' },
  { name: 'Exception', when: 'Launch · expiring', text: 'Manual members for contractors and short-lived needs. Must renew to meet cyber policy. Owners get notified as the date nears.' },
  { name: 'Bulk dynamic', when: 'Later · at scale', text: 'One rule set, many groups: a group for every value of an attribute (e.g. each store, or HR in each state), instead of building them one by one.' },
  { name: 'Nested', when: 'Later · reuse', text: 'Compose groups and individuals into one audience. Reuse dynamics without rewriting rules.' },
];

const researchInsights = [
  { label: 'FAMILIAR CONVENTIONS', text: 'Admins expect groups, roles, and inheritance language from SharePoint and Azure, but not admin-console complexity.' },
  { label: 'NEW OPERATORS', text: 'Content authors had never managed access. Defaults had to be safe; power had to be gated, not assumed.' },
  { label: 'SPRAWL IS THE RISK', text: 'Legacy had thousands of unowned groups. Ownership and expiration became non‑negotiable in the model, not policy docs.' },
  { label: 'OPAQUE DATA', text: 'HR attributes read like database columns. I inventoried the UXP attribute set and cut/renamed the defaults so authors could build rules without decoding fields.' },
];

const researchFindings = [
  { text: "There's no way to see all permissions applied across all sites in one place.", who: 'Content author' },
  { text: "If you break inheritance at one level, it's impossible to tell - and it breaks all nested pages as well.", who: 'Content author' },
  { text: "I can't tell what members are in groups I apply.", who: 'Content author' },
  { text: 'I have to wait for days to get access changed.', who: 'Content author' },
  { text: "It's hard to be sure of legal compliance.", who: 'Compliance' },
  { text: 'I wish it was easier to create test pages with specific people.', who: 'Content author' },
  { text: "I don't know what groups we're supposed to use.", who: 'Content author' },
];

const researchTools = [
  {
    name: 'Airtable',
    src: '/images/enterprise-permissions/research-airtable.png',
    alt: 'Airtable nested AND/OR condition groups for filtering records',
    notes: [
      'Visual AND/OR condition nesting. Good model for our dynamic rule creator.',
      'Progressive add-condition pattern keeps it approachable. Users build complexity as needed.',
    ],
  },
  {
    name: 'Azure AD',
    src: '/images/enterprise-permissions/research-azure.png',
    alt: 'Azure AD dynamic membership rules with simple and advanced rule tabs',
    notes: [
      'Simple vs. advanced rule toggle. Guided builder for most users, raw expressions as an escape hatch.',
      'Dynamic group membership based on attribute rules. Informed our auto-assignment approach.',
    ],
  },
  {
    name: 'SharePoint',
    src: '/images/enterprise-permissions/research-sharepoint.png',
    alt: 'SharePoint permissions list with groups, users, and named permission levels',
    notes: [
      'Groups and individuals in one list with named permission levels. Clean reference for apply permissions.',
      'Named roles (Full Control, View Only) over checkbox grids. Less cognitive load.',
    ],
  },
  {
    name: 'Azure Groups',
    src: '/images/enterprise-permissions/research-azure-groups.png',
    alt: 'Azure All groups overview with type and membership type columns',
    notes: [
      'All groups overview with type labels (Microsoft 365, Security) and membership type (Assigned, Dynamic).',
      'Filtering and search built into the list. Reference for our manage groups view.',
    ],
  },
];

/* Surface names live in the loop diagram lane labels (§5.1); step chips removed per §4.6 */
const flow = [
  { phase: '01 · DEFINE', title: 'Admins create reusable groups', text: 'Dynamic rules for steady audiences, exception groups for temporary access. Ownership and expiration are required, not optional.' },
  { phase: '02 · APPLY', title: 'Authors permission pages at publish', text: 'Search pages, see publish and permission status, then apply the right groups before go-live, without an IT ticket.' },
  { phase: '03 · CASCADE', title: 'Inheritance stays a deliberate choice', text: 'Parent access can flow to child pages only when an author confirms it. Visible, reversible, auditable.' },
  { phase: '04 · GOVERN', title: 'Exceptions renew or expire', text: 'Temporary access escalates as the deadline nears, then locks past renewal, so sprawl cannot quietly accumulate.' },
];

const renameChips = [
  { from: 'Leader 3 Email', to: 'Employee - VP' },
  { from: 'Employee Type', to: 'Pay Type' },
  { from: 'Department', to: 'Functional Group' },
];

const resultHighlights = [
  { stat: '3,000+', label: 'pages permissioned in month one · zero admin intervention' },
  { stat: '~30', label: 'governed groups at steady state' },
  { stat: '0', label: 'IT tickets for routine access changes' },
];

const learnings = [
  'Governance works when it’s built into the model, not a policy doc.',
  'Design for the least-technical owner. Safer for everyone, including admins.',
  'The constraints that mattered most (overnight sync, opaque HR attributes, UI terms that didn’t match the system) I found by testing, not by spec.',
];
---
<CaseStudy
  case={c}
  intro="Redesigning how 150K+ T-Mobile employees get access to internal tools, owned end-to-end by content teams instead of IT tickets."
  meta={[
    { key: 'ROLE', value: 'Sole designer' },
    { key: 'COMPANY', value: 'T-Mobile' },
    { key: 'YEAR', value: '2025' },
    { key: 'DURATION', value: '6 months' },
    { key: 'SCOPE', value: '150K+ employees' },
  ]}
  heroAlt="Group Management: group detail with members, applied pages, dynamic rule, and activity log"
  problem="Every permission change was an IT ticket. Content teams waited days for access they should have been able to grant themselves."
  outcome="A self-serve permission system content teams run on their own: designed, tested, and shipped as the sole designer."
>
  <section class="sec">
    <div class="sec-label">THE CONTEXT</div>
    <h2 class="sec-heading">One intranet for 150,000+ employees, permissions owned by content teams.</h2>
    <p class="sec-body">
      Three platforms into one intranet for 150K+ employees. Permissions had to ship with launch, owned by content teams, not an IT queue. I was sole designer and one of two business owners across requirements, the group model, both surfaces, a11y, QA, and onboarding.
    </p>
    <p class="sec-body">Partnered with TPM, technical architect, design systems, and accessibility.</p>
    <div class="case-grid-3">
      <div class="case-card accent">
        <div class="case-card-label">SCALE</div>
        <div class="case-stat-num">150K+</div>
        <div class="case-card-body">employees on platform.</div>
      </div>
      <div class="case-card accent">
        <div class="case-card-label">MONTH ONE</div>
        <div class="case-stat-num">3,000+</div>
        <div class="case-card-body">pages permissioned by content teams.</div>
      </div>
      <div class="case-card accent">
        <div class="case-card-label">ADMIN LOAD</div>
        <div class="case-stat-num">0</div>
        <div class="case-card-body">admin interventions needed.</div>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="sec-label">RESEARCH</div>
    <h2 class="sec-heading">Grounding the model in how permissions already work, and who would run this one.</h2>
    <p class="sec-body">
      Cross-market analysis (SharePoint, Azure, Airtable) plus interviews with admins, content owners, and compliance, then four constraints that shaped the model:
    </p>

    <h3 class="sec-subhead">What authors were already living with</h3>
    <div class="ep-research-quotes">
      {researchFindings.map((f) => (
        <div class="case-card">
          <div class="case-quote-text">"{f.text}"</div>
          <div class="case-quote-who">{f.who}</div>
        </div>
      ))}
    </div>

    <h3 class="sec-subhead">Current tools</h3>
    <p class="sec-body">
      Each platform had pieces worth borrowing - and each assumed a technical operator.
    </p>
    <div class="ep-research-tools">
      {researchTools.map((t) => (
        <div class="ep-tool">
          <div class="ep-tool-shot">
            <img src={t.src} alt={t.alt} />
          </div>
          <div class="ep-tool-name">{t.name}</div>
          <div class="ep-tool-notes">
            {t.notes.map((n) => (
              <p>{n}</p>
            ))}
          </div>
        </div>
      ))}
    </div>

    <h3 class="sec-subhead">Four constraints that shaped the model</h3>
    <div class="case-grid-2 ep-insights">
      {researchInsights.map((item) => (
        <div class="case-card">
          <div class="case-card-label">{item.label}</div>
          <div class="case-card-body">{item.text}</div>
        </div>
      ))}
    </div>
    <div class="case-ridge">
      <div class="case-ridge-strip">THE DESIGN BAR</div>
      <div class="case-ridge-body">
        <div class="case-ridge-heading">Follow the conventions admins already know. Strip the complexity that assumes a technical operator.</div>
      </div>
    </div>

    <div class="ep-attr-inv" aria-label="UXP attribute inventory">
      <div class="attr-stats">
        <div><span class="l">Audited</span><span class="v">39</span><span class="s">attributes in the UXP set</span></div>
        <div><span class="l">Cut</span><span class="v">15</span><span class="s">removed outright</span></div>
        <div><span class="l">Renamed</span><span class="v">15</span><span class="s">kept, relabeled for authors</span></div>
        <div><span class="l">Untouched</span><span class="v">9</span><span class="s">shipped as-is</span></div>
      </div>

      <div class="inv">
        <div class="inv-h"><div>As named in UXP</div><div>What authors see</div></div>

        <div class="grp ren">
          <div class="grp-l"><span>Renamed - the Leader block</span><span>9</span></div>
          <div class="row"><div>Leader 0 Email</div><div>Employee - CEO</div></div>
          <div class="row"><div>Leader 1 Email</div><div>Employee - EVP</div></div>
          <div class="row"><div>Leader 2 Email</div><div>Employee - SVP</div></div>
          <div class="row"><div>Leader 3 Email</div><div>Employee - VP</div></div>
          <div class="row"><div>Leader 4 Email</div><div>Employee - Sr Director</div></div>
          <div class="row"><div>Leader 5 Email</div><div>Employee - Director</div></div>
          <div class="row"><div>Leader 6 Email</div><div>Employee - IC Director</div></div>
          <div class="row"><div>Leader 7 Email</div><div>Employee - Sr Manager</div></div>
          <div class="row"><div>Leader 8 Email</div><div>Employee - Manager</div></div>
        </div>
      </div>
      <p class="inv-more">+30 more audited across cut, renamed, and kept.</p>
    </div>
  </section>

  <section class="sec">
    <div class="sec-label">THE GROUP MODEL</div>
    <h2 class="sec-heading">Four group types, each with explicit ownership and expiration, so groups can’t sprawl.</h2>
    <p class="sec-body">Dynamic and exception groups shipped at launch; bulk dynamic and nested groups followed later, by request.</p>

    <figure class="ep-diagram ep-group-model">
      <svg viewBox="0 0 1000 520" role="img" aria-label="Group model diagram. A governance bar across the top applies owner-required-at-creation and expiration policy to all four group types. Launch types: Dynamic (attribute rules) and Exception (manual, expiring). Later types: Bulk Dynamic, which generates many dynamic groups from one rule set, and Nested, which composes dynamic and exception groups plus individuals into one audience.">
        <defs>
          <marker id="ar2" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
            <path d="M 0 0 L 10 5 L 0 10 z" fill="currentColor"/>
          </marker>
        </defs>

        <rect x="60" y="40" width="880" height="52" rx="4" fill="var(--mag-bg)" stroke="var(--mag)" stroke-width="1.5"/>
        <text x="80" y="63" font-size="10" font-family="var(--font-mono),ui-monospace,monospace" fill="var(--mag)" font-weight="700" letter-spacing="1.2">ONE GOVERNANCE CONTRACT · ALL FOUR TYPES</text>
        <text x="80" y="81" font-size="12.5" fill="currentColor">Owner named at creation &#160;·&#160; expiration policy attached &#160;·&#160; membership auditable</text>

        <line x1="180" y1="92" x2="180" y2="128" stroke="var(--mag)" stroke-width="1.2" opacity=".45"/>
        <line x1="420" y1="92" x2="420" y2="128" stroke="var(--mag)" stroke-width="1.2" opacity=".45"/>
        <line x1="660" y1="92" x2="660" y2="128" stroke="var(--mag)" stroke-width="1.2" opacity=".45"/>
        <line x1="860" y1="92" x2="860" y2="128" stroke="var(--mag)" stroke-width="1.2" opacity=".45"/>

        <text x="60" y="146" font-size="10" font-family="var(--font-mono),ui-monospace,monospace" fill="var(--keep)" font-weight="700" letter-spacing="1.2">SHIPPED AT LAUNCH</text>
        <text x="560" y="146" font-size="10" font-family="var(--font-mono),ui-monospace,monospace" fill="currentColor" opacity=".55" font-weight="700" letter-spacing="1.2">ADDED LATER, BY REQUEST</text>
        <line x1="60" y1="154" x2="530" y2="154" stroke="var(--keep)" stroke-width="1.5" opacity=".5"/>
        <line x1="560" y1="154" x2="940" y2="154" stroke="currentColor" stroke-width="1.5" opacity=".25" stroke-dasharray="4 3"/>

        <rect x="60" y="176" width="240" height="118" rx="4" fill="var(--panel)" stroke="var(--keep)" stroke-width="1.8"/>
        <text x="80" y="203" font-size="16" font-weight="650" fill="currentColor">Dynamic</text>
        <rect x="180" y="189" width="60" height="18" rx="9" fill="var(--keep-bg)"/>
        <text x="210" y="202" text-anchor="middle" font-size="9.5" font-family="var(--font-mono),ui-monospace,monospace" fill="var(--keep)" font-weight="700">DEFAULT</text>
        <text x="80" y="228" font-size="12" fill="currentColor" opacity=".75">Membership from attribute rules</text>
        <text x="80" y="247" font-size="12" fill="currentColor" opacity=".75">e.g. all People Managers</text>
        <text x="80" y="275" font-size="11" fill="currentColor" opacity=".5">Saves immediately · syncs overnight</text>

        <rect x="60" y="316" width="240" height="118" rx="4" fill="var(--panel)" stroke="var(--keep)" stroke-width="1.8"/>
        <text x="80" y="343" font-size="16" font-weight="650" fill="currentColor">Exception</text>
        <rect x="187" y="329" width="66" height="18" rx="9" fill="var(--mag-bg)"/>
        <text x="220" y="342" text-anchor="middle" font-size="9.5" font-family="var(--font-mono),ui-monospace,monospace" fill="var(--mag)" font-weight="700">EXPIRING</text>
        <text x="80" y="368" font-size="12" fill="currentColor" opacity=".75">Manual members - contractors,</text>
        <text x="80" y="387" font-size="12" fill="currentColor" opacity=".75">testing, short-lived needs</text>
        <text x="80" y="415" font-size="11" fill="var(--mag)" opacity=".9">Must renew or it stops granting access</text>

        <rect x="560" y="176" width="380" height="118" rx="4" fill="var(--panel)" stroke="currentColor" stroke-width="1.3" stroke-dasharray="5 3" opacity=".85"/>
        <text x="580" y="203" font-size="16" font-weight="650" fill="currentColor">Bulk dynamic</text>
        <text x="580" y="228" font-size="12" fill="currentColor" opacity=".75">One rule set generates many groups -</text>
        <text x="580" y="247" font-size="12" fill="currentColor" opacity=".75">one per value of an attribute</text>
        <text x="580" y="275" font-size="11" fill="currentColor" opacity=".5">e.g. a group for every store, or HR in each state</text>

        <rect x="560" y="316" width="380" height="118" rx="4" fill="var(--panel)" stroke="currentColor" stroke-width="1.3" stroke-dasharray="5 3" opacity=".85"/>
        <text x="580" y="343" font-size="16" font-weight="650" fill="currentColor">Nested</text>
        <text x="580" y="368" font-size="12" fill="currentColor" opacity=".75">Composes existing groups and individuals</text>
        <text x="580" y="387" font-size="12" fill="currentColor" opacity=".75">into one audience</text>
        <text x="580" y="415" font-size="11" fill="currentColor" opacity=".5">Reuse without rewriting rules</text>

        <path d="M 300 224 L 430 224 L 430 214 L 554 214" fill="none" stroke="currentColor" stroke-width="1.5" opacity=".5" marker-end="url(#ar2)"/>
        <text x="428" y="204" text-anchor="middle" font-size="10.5" fill="currentColor" opacity=".7">generates many</text>

        <path d="M 300 262 L 400 262 L 400 366 L 554 366" fill="none" stroke="currentColor" stroke-width="1.5" opacity=".5" marker-end="url(#ar2)"/>
        <path d="M 300 396 L 400 396 L 400 380 L 554 380" fill="none" stroke="currentColor" stroke-width="1.5" opacity=".5" marker-end="url(#ar2)"/>
        <text x="452" y="344" text-anchor="middle" font-size="10.5" fill="currentColor" opacity=".7">composed into</text>

        <text x="60" y="478" font-size="12" fill="currentColor" opacity=".6">The later types add no new governance rules - they compose the launch types, so ownership and expiry carry through.</text>
      </svg>
      <figcaption>Four types, one governance contract - ownership and expiration attach at creation, and the two later types compose the first two rather than escaping their rules.</figcaption>
    </figure>

    <div class="ep-taxonomy" aria-label="Group taxonomy">
      <ul class="case-factors ep-taxonomy-list">
        {groupTaxonomy.map((g) => (
          <li class="case-factor">
            <div class="case-factor-body">
              <div style="display:flex;justify-content:space-between;align-items:baseline;gap:12px;margin-bottom:6px">
                <span class="case-card-label" style="margin-bottom:0">{g.name}</span>
                <span class="case-card-tag">{g.when}</span>
              </div>
              <div class="case-card-body">{g.text}</div>
            </div>
          </li>
        ))}
      </ul>
      <p class="case-source">Four types · one governance contract · launch vs later</p>
    </div>

    <h3 class="sec-subhead">Ownership is required at creation, not discovered later in an audit.</h3>
    <p class="sec-body">Every group names its owners up front. That made accountability visible from day one and gave content teams a clear person to ask when access needed to change.</p>
    <figure class="case-fig">
      <img src="/images/enterprise-permissions/ep-set-owners.png" alt="Set Group Owners: searching and selecting named owners at group creation" />
      <figcaption>Set Group Owners: search, select, and confirm owners before the group exists</figcaption>
    </figure>

    <h3 class="sec-subhead">Exception groups escalate, then lock, so temporary access cannot quietly stick around.</h3>
    <p class="sec-body">Renewal prompts appear as the deadline nears. Past the deadline, the group requires review before it can keep granting access.</p>
    <div class="case-grid-2" style="margin-top:16px">
      <figure class="case-fig bare" style="margin-top:0">
        <img src="/images/enterprise-permissions/ep-exception-renewal.png" alt="Exception group card: renew within 30 days warning" />
        <figcaption>Within 30 days: renew before the deadline</figcaption>
      </figure>
      <figure class="case-fig bare" style="margin-top:0">
        <img src="/images/enterprise-permissions/ep-exception-review.png" alt="Exception group card: past renewal deadline, requires review" />
        <figcaption>Past deadline: review required to restore access</figcaption>
      </figure>
    </div>
  </section>

  <section class="sec">
    <div class="sec-label">HOW IT WORKS</div>
    <h2 class="sec-heading">One loop from group definition to page access, with governance at every step.</h2>
    <p class="sec-body">Admins define reusable audiences. Authors apply them when content ships. Inheritance and expiration keep the system honest after launch.</p>

    <figure class="ep-loop">
      <svg viewBox="0 0 1000 440" role="img" aria-label="Two-lane process diagram. Admin lane: Define groups. Author lane: Apply permissions, then Cascade to child pages. Govern spans both lanes and returns to Define, closing the loop. Governance gates: ownership required at creation, renew or expire.">
        <defs>
          <marker id="ar" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
            <path d="M 0 0 L 10 5 L 0 10 z" fill="currentColor"/>
          </marker>
          <marker id="arM" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
            <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--mag)"/>
          </marker>
        </defs>

        <rect x="120" y="66" width="800" height="104" rx="3" fill="var(--admin-bg)"/>
        <rect x="120" y="186" width="800" height="104" rx="3" fill="var(--author-bg)"/>

        <text x="112" y="112" text-anchor="end" font-size="12" font-weight="700" fill="var(--admin)">ADMIN</text>
        <text x="112" y="129" text-anchor="end" font-size="10.5" fill="currentColor" opacity=".55">Group Management</text>
        <text x="112" y="232" text-anchor="end" font-size="12" font-weight="700" fill="var(--author)">AUTHOR</text>
        <text x="112" y="249" text-anchor="end" font-size="10.5" fill="currentColor" opacity=".55">Apply Permissions</text>

        <rect x="150" y="88" width="152" height="60" rx="4" fill="var(--panel)" stroke="var(--admin)" stroke-width="1.5"/>
        <text x="164" y="108" font-size="10" font-family="var(--font-mono),ui-monospace,monospace" fill="var(--admin)" font-weight="700">01</text>
        <text x="164" y="127" font-size="15" font-weight="650" fill="currentColor">Define</text>
        <text x="226" y="127" font-size="11" fill="currentColor" opacity=".6">groups</text>

        <rect x="392" y="208" width="152" height="60" rx="4" fill="var(--panel)" stroke="var(--author)" stroke-width="1.5"/>
        <text x="406" y="228" font-size="10" font-family="var(--font-mono),ui-monospace,monospace" fill="var(--author)" font-weight="700">02</text>
        <text x="406" y="247" font-size="15" font-weight="650" fill="currentColor">Apply</text>
        <text x="459" y="247" font-size="11" fill="currentColor" opacity=".6">at publish</text>

        <rect x="592" y="208" width="152" height="60" rx="4" fill="var(--panel)" stroke="var(--author)" stroke-width="1.5"/>
        <text x="606" y="228" font-size="10" font-family="var(--font-mono),ui-monospace,monospace" fill="var(--author)" font-weight="700">03</text>
        <text x="606" y="247" font-size="15" font-weight="650" fill="currentColor">Cascade</text>

        <rect x="800" y="88" width="104" height="180" rx="4" fill="var(--mag-bg)" stroke="var(--mag)" stroke-width="1.5"/>
        <text x="816" y="112" font-size="10" font-family="var(--font-mono),ui-monospace,monospace" fill="var(--mag)" font-weight="700">04</text>
        <text x="816" y="132" font-size="15" font-weight="650" fill="currentColor">Govern</text>
        <text x="816" y="152" font-size="10.5" fill="currentColor" opacity=".65">spans both</text>
        <text x="816" y="167" font-size="10.5" fill="currentColor" opacity=".65">roles</text>

        <path d="M 302 122 L 350 122 L 350 238 L 386 238" fill="none" stroke="currentColor" stroke-width="1.5" opacity=".55" marker-end="url(#ar)"/>
        <text x="356" y="184" font-size="10.5" fill="currentColor" opacity=".7">reusable</text>
        <text x="356" y="197" font-size="10.5" fill="currentColor" opacity=".7">audiences</text>

        <line x1="544" y1="238" x2="586" y2="238" stroke="currentColor" stroke-width="1.5" opacity=".55" marker-end="url(#ar)"/>
        <text x="565" y="228" text-anchor="middle" font-size="10.5" fill="currentColor" opacity=".7">parent → child</text>

        <path d="M 744 238 L 772 238 L 772 178 L 794 178" fill="none" stroke="currentColor" stroke-width="1.5" opacity=".55" marker-end="url(#ar)"/>

        <path d="M 852 268 L 852 356 L 226 356 L 226 154" fill="none" stroke="var(--mag)" stroke-width="2" marker-end="url(#arM)"/>
        <rect x="452" y="342" width="176" height="26" rx="3" fill="var(--bg)"/>
        <text x="540" y="360" text-anchor="middle" font-size="11.5" font-weight="650" fill="var(--mag)">expiry closes the loop</text>

        <line x1="226" y1="88" x2="226" y2="64" stroke="var(--admin)" stroke-width="1.2" opacity=".6"/>
        <circle cx="226" cy="58" r="4" fill="var(--admin)"/>
        <text x="226" y="42" text-anchor="middle" font-size="11" font-weight="600" fill="var(--admin)">owner required at creation</text>

        <line x1="852" y1="88" x2="852" y2="64" stroke="var(--mag)" stroke-width="1.2" opacity=".6"/>
        <circle cx="852" cy="58" r="4" fill="var(--mag)"/>
        <text x="852" y="42" text-anchor="middle" font-size="11" font-weight="600" fill="var(--mag)">renew or expire</text>

        <text x="150" y="404" font-size="11" fill="currentColor" opacity=".5">No IT ticket at any step.</text>
      </svg>
      <figcaption>One loop, two roles: admins define reusable audiences, authors apply them at publish, and expiry closes it back to definition.</figcaption>
    </figure>

    <div class="case-grid-2" style="margin-top:22px">
      {flow.map((step) => (
        <div class="ep-flow-step">
          <div style="margin-bottom:8px">
            <span class="case-card-label" style="margin-bottom:0">{step.phase}</span>
          </div>
          <div class="sec-subhead" style="margin-top:0">{step.title}</div>
          <div class="case-card-body" style="margin-top:8px">{step.text}</div>
        </div>
      ))}
    </div>
  </section>

  <section class="sec">
    <div class="sec-label">TWO SURFACES</div>
    <h2 class="sec-heading">The same group model, shown where each role needs it.</h2>
    <p class="sec-body">
      Admins start in Group Management: find a group, open details, manage membership and rules. Authors work in Apply Permissions at publish time, with publish and permission status side by side before go-live. The hero above is Group Management in motion.
    </p>

    <div class="ep-pair-figs">
      <figure class="case-fig">
        <img src="/images/enterprise-permissions/ep-group-management-dynamic.png" alt="Group Management: group list with New Group menu for Exception, Dynamic, Bulk Dynamic, and Nested" />
        <figcaption>Admins start here - every group type, every owner, searchable in one view</figcaption>
      </figure>
      <figure class="case-fig">
        <img src="/images/enterprise-permissions/ep-apply-permissions-list.png" alt="Apply Permissions: page list with publish status, permission status, and manage actions" />
        <figcaption>Authors · Apply Permissions: publish status and permission status together</figcaption>
      </figure>
    </div>
  </section>

  <section class="sec ep-iteration">
    <div class="sec-label">ITERATION</div>
    <h2 class="sec-heading">The first two rule builders failed accessibility review. The third borrowed from Salesforce.</h2>
    <p class="sec-body">
      The first rule builder exposed three add-buttons whose behavior wasn't obvious even to me, and a table that only allowed rows at the end. I grouped the expressions, moved nesting into a row menu, and darkened the nested signifiers to hit AAA contrast.
    </p>
    <p class="sec-body">
      The accessibility team rejected it anyway - nested blocks weren't traceable by screen readers, the format broke under standard table CSS, and there was no room for validation errors. The fix came from Salesforce's tree grid: collapsible rows for nested values, sized to hold text and errors at a 1200px floor.
    </p>

    <AnnotationFigure
      src="/images/enterprise-permissions/ep-rulebuilder-v1.png"
      alt="Dynamic Rule Creator v1: expression rows with three add-buttons beneath"
      caption="v1: the interaction model assumed the operator already understood the data schema"
      pins={[
        { n: 1, left: '26%', top: '76%' },
        { n: 2, left: '4%', top: '48%' },
        { n: 3, left: '12%', top: '62%' },
        { n: 4, left: '34%', top: '22%' },
      ]}
      items={[
        { num: 1, text: 'Three add-buttons, unclear function' },
        { num: 2, text: "Nesting can't be edited after creation" },
        { num: 3, text: 'Rows only append at the end' },
        { num: 4, text: 'Attribute names read as database columns' },
      ]}
    />

    <AnnotationFigure
      src="/images/enterprise-permissions/ep-rulebuilder-v2.png"
      alt="Bulk Dynamic Rule Creator: For Each row, nested expressions, and open row menu with Nest Expression"
      caption="Better, and still not accessible - the table model itself was the problem"
      pins={[
        { n: 1, left: '88%', top: '58%' },
        { n: 2, left: '6%', top: '62%' },
        { n: 3, left: '50%', top: '78%' },
      ]}
      items={[
        { num: 1, text: 'Grouped expressions and a row menu' },
        { num: 2, text: 'AAA contrast on nested signifiers' },
        { num: 3, text: 'Then rejected: not screen-reader traceable · breaks standard table CSS · no room for validation errors' },
      ]}
    />
    <AnnotationFigure
      src="/images/enterprise-permissions/ep-reference-treegrid.png"
      alt="Salesforce Base Tree Grid reference: collapsible hierarchical rows"
      caption="The pattern that unblocked it - collapsible rows keep nested hierarchy traceable to a screen reader"
    />

    <AnnotationFigure
      src="/images/enterprise-permissions/ep-rulebuilder-v3.png"
      alt="Dynamic Rule Creator v3: collapsible nested rows with reserved error space"
      caption="Shipped: worked out with the a11y partner, not retrofitted"
      pins={[
        { n: 1, left: '4%', top: '42%' },
        { n: 2, left: '48%', top: '38%' },
        { n: 3, left: '28%', top: '52%' },
      ]}
      items={[
        { num: 1, text: 'Nested expressions collapse' },
        { num: 2, text: 'Fixed widths hold at 1200px' },
        { num: 3, text: 'Error space reserved, no shift' },
      ]}
    />
  </section>

  <section class="sec">
    <div class="sec-label">DESIGNED FOR FIRST-TIME OWNERS</div>
    <h2 class="sec-heading">Familiar patterns, safer defaults, and errors caught at the moment of entry.</h2>
    <p class="sec-body">
      The platform had no established patterns for search, tables, filtering, or inline validation. I designed them to align with the new design system’s semantic tokens and interaction patterns. Purpose-built for Permissions, reviewed with the DS team and a11y partner, and signed off before ship.
    </p>

    <div class="case-card" style="margin-top:16px">
      <div class="case-card-label">Foundations first</div>
      <div class="case-card-body">
        Search, tables, filters, and validation shipped as shared components within Permissions, not generic library widgets reused from elsewhere. Bulk imports flag bad rows inline and skip them, so good entries still proceed.
      </div>
      <div class="ep-pattern-chips">
        <span>Search</span>
        <span>Data table</span>
        <span>Filters</span>
        <span>Validation</span>
      </div>
    </div>

    <figure class="case-fig">
      <img src="/images/enterprise-permissions/ep-group-management-filtered.png" alt="Group Management filtered to Dynamic: search, group type and owner filters, and results table" />
      <figcaption>The patterns owners use daily - built for Permissions, not borrowed from a generic library</figcaption>
    </figure>

    <figure class="case-fig">
      <img src="/images/enterprise-permissions/ep-bulk-import.png" alt="Create Exception Group: member search, bulk import, toast for invalid rows, and per-row inline validation" />
      <figcaption>Create Exception Group: bulk import keeps valid members and flags bad rows inline</figcaption>
    </figure>

    <h3 class="sec-subhead">A rule builder for two audiences: visual for most, syntax for the advanced.</h3>
    <p class="sec-body">
      I renamed cryptic HR attributes for non-technical authors and only 9 of 39 attributes shipped unchanged. The live syntax view validates complex logic as it’s built.
    </p>
    <div class="ep-renames" aria-label="Attribute renames">
      {renameChips.map((r) => (
        <div class="ep-rename">
          <code>{r.from}</code>
          <span aria-hidden="true">→</span>
          <strong>{r.to}</strong>
        </div>
      ))}
    </div>
  </section>

  <section class="sec">
    <div class="sec-label">KEY DECISION</div>
    <div class="case-ridge" style="margin-top:14px">
      <div class="case-ridge-strip">INHERITANCE AT MIGRATION SCALE</div>
      <div class="case-ridge-body">
        <div class="case-ridge-heading">Inheritance is an explicit author action, never a silent cascade.</div>
        <p class="sec-body">
          Automatic inheritance wasn’t technically feasible at migration scale, and most alternatives were too complex to build or too opaque for authors. Instead, authors choose when parent access flows to child pages, with clear control over which groups apply. Visible, reversible, auditable. A later enhancement let pages inherit from already-permissioned parents, cutting effort further.
        </p>
      </div>
    </div>
    <figure class="case-fig bare">
      <img src="/images/enterprise-permissions/cascade-permissions.png" alt="Apply Permissions: explicit add-parent and replace-child inheritance actions with confirmation" />
      <figcaption>Inheritance is a decision, not a default - every cascade is confirmed, visible, and reversible</figcaption>
    </figure>
    <figure class="case-fig bare">
      <img src="/images/enterprise-permissions/ep-cascade-flow.png" alt="Cascade task flow from Apply Permissions through child pages dashboard and back to Apply Permissions Details" />
      <figcaption>The cascade path end to end - every step an author takes to push parent access down, none of it automatic</figcaption>
    </figure>
    <div class="case-card" style="margin-top:16px">
      <div class="case-card-label">Open unless compliance says otherwise</div>
      <div class="case-card-body">Content is open by default and locked down only where compliance requires it, so most of the intranet stays usable without maintaining permissions on every page.</div>
    </div>
  </section>

  <section class="sec">
    <div class="sec-label">SYSTEM + SCALE</div>
    <h2 class="sec-heading">50+ screens, ~5 flows, one component system.</h2>
    <p class="sec-body">
      Scope shifted constantly across the cycle. Variant architecture let new compositions absorb that change without redesigning the underlying system each time.
    </p>
    <figure class="case-fig bare">
      <img src="/images/enterprise-permissions/ep-system-iterations.png" alt="Iterations board with dozens of permission screens organized in color-coded swim lanes" />
      <figcaption>50+ screens across ~5 core flows, built on one component system - so shifting scope meant new compositions, not new design work</figcaption>
    </figure>
    <figure class="case-fig bare">
      <img src="/images/enterprise-permissions/ep-system-components.png" alt="Annotated component primitives: New group menu, member actions, dynamic rule rows, expression groups, rule syntax, and pagination" />
      <figcaption>Menus, rule rows, search, and tables - the same primitives composed across every flow</figcaption>
    </figure>
    <figure class="case-fig bare">
      <img src="/images/enterprise-permissions/ep-system-handoff.png" alt="Sprint 1 UX handoff showing two numbered Group Management workstreams with annotated screens" />
      <figcaption>Sprint handoff: annotated screens, requirements, and dev notes - scoped in two-week windows</figcaption>
    </figure>
    <p class="sec-body">
      Permissions apply at page level and component level, with globals responding inherently so authors don’t re-permission every surface by hand.
    </p>
    <p class="sec-body">
      Adoption safeguards include threshold warnings on large dynamic group updates before they sync overnight.
    </p>
  </section>

  <section class="sec ep-impact">
    <div class="sec-label">IMPACT</div>
    <div class="case-grid-3 ep-scan-stats">
      {resultHighlights.map((h) => (
        <div class="case-card accent">
          <div class="case-stat-num">{h.stat}</div>
          <div class="case-card-body">{h.label}</div>
        </div>
      ))}
    </div>

    <p class="sec-body">
      Model held months after launch. I did deep manual validation against real HR data (SQL, Postman, cron behavior) before builds were finished. That work surfaced overnight sync, mismatched attribute labels, and other gaps the spec never mentioned. I wrote the admin/author guides and a failsafe BRD, and onboarded content teams before platform go live.
    </p>

    <ol class="case-factors ep-learnings">
      {learnings.map((item, i) => (
        <li class="case-factor">
          <span class="case-factor-num">{String(i + 1).padStart(2, '0')}</span>
          <div class="case-factor-body">
