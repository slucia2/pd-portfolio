<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const gallery = document.querySelector('[data-sr-gallery]');
  if (gallery && !reduceMotion) {
    const slides = [...gallery.querySelectorAll('[data-gallery-slide]')];
    let index = 0;
    let timer = 0;
    const show = (next) => {
      index = next % slides.length;
      slides.forEach((s, i) => s.classList.toggle('is-active', i === index));
    };
    const start = () => {
      if (timer) return;
      timer = window.setInterval(() => show(index + 1), 2600);
    };
    const stop = () => {
      window.clearInterval(timer);
      timer = 0;
    };
    const io = new IntersectionObserver(
      ([entry]) => (entry.isIntersecting ? start() : stop()),
      { threshold: 0.35 },
    );
    io.observe(gallery);
  }

  const paywall = document.querySelector('[data-sr-paywall]');
  const paywallVideo = paywall?.querySelector('video');
  if (paywall && paywallVideo && !reduceMotion) {
    const io = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) paywallVideo.play().catch(() => {});
        else paywallVideo.pause();
      },
      { threshold: 0.4 },
    );
    io.observe(paywall);
  }
</script>

