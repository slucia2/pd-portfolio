---
import CaseStudy from '../../layouts/CaseStudy.astro';
import { cases } from '../../data/cases';

const c = cases.find((x) => x.slug === 'scamranger')!;
const next = cases.find((x) => x.slug === 'myintake')!;
const nextHref = `/work/${next.slug}/`;

const gallerySlides = [
  { src: '/images/scamranger/onb-gallery.png', alt: 'Gallery slide: scams are everywhere' },
  { src: '/images/scamranger/onb-gallery-2.png', alt: 'Gallery slide: stay protected' },
  { src: '/images/scamranger/onb-gallery-3.png', alt: 'Gallery slide: trusted by institutions' },
];

const typeScale = [
  { name: 'Display', spec: '48 / 125, Regular' },
  { name: 'H1', spec: '34 / 125, Medium' },
  { name: 'H2', spec: '28 / 162, Medium' },
  { name: 'H3', spec: '22 / 150, Medium' },
  { name: 'Body Large', spec: '20 / 165, Regular' },
  { name: 'Body', spec: '18 / 165, Regular' },
  { name: 'UI Button', spec: '18 / 125, Semibold' },
];

const colors = [
  { name: 'brand/primary', hex: '#7B5CF8', use: 'Primary action' },
  { name: 'brand/medium', hex: '#9B85FF', use: 'Press, links' },
  { name: 'brand/light', hex: '#C9BDFF', use: 'Text tints' },
  { name: 'brand/dark', hex: '#5533CC', use: 'Disabled' },
  { name: 'bg/start', hex: '#2E1B6E', use: 'Gradient 0%' },
  { name: 'bg/end', hex: '#08052A', use: 'Gradient 100%' },
  { name: 'text/primary', hex: '#FFFFFF', use: 'Body, labels' },
  { name: 'status/error', hex: '#FF8080', use: 'Errors' },
];

const guidelines = [
  { title: '18px body floor', text: 'Real content never drops below 18. 14px only for chrome like field labels. Older audience, NN/g guidance.' },
  { title: '44px+ tap targets', text: 'Buttons, rows, and nav meet Apple HIG / WCAG touch guidance, sized for motor impairment risk.' },
  { title: 'Solid color, not opacity', text: 'Solid tokens only. Opacity washes over gradients made contrast unreliable in production.' },
  { title: 'Dedicated T&C for banks', text: 'Partnerships need explicit consent. Dedicated terms screen, not buried next to a secondary action.' },
  { title: 'Permission with context', text: 'Explain why each setting matters before sending someone into iOS Settings.' },
];

const rationale = [
  {
    area: 'Home',
    delivered: 'Opens on content: tip, scan, bank block, links',
    now: 'Opens on “am I safe?”, then recent checks',
    why: 'Answers the question people open the app with. Untested with users.',
    seen: 'Rocket Money: summary first, then recent activity',
  },
  {
    area: 'Type',
    delivered: 'Body 16–18, nav labels 11',
    now: 'Body 18 throughout, titles 22, nav 13',
    why: 'People in their 40s already need larger type (NN/g).',
    seen: 'Apple HIG: 17pt body by default',
  },
  {
    area: 'Touch targets',
    delivered: 'Rows ~72pt, nav ~56pt, links inline',
    now: 'Rows 76–80pt, buttons 60–64pt, tabs 75pt',
    why: 'About 1 in 5 over-65s has some tremor (W3C).',
    seen: 'Apple HIG: 44pt minimum',
  },
  {
    area: 'Color',
    delivered: 'Brand carried by gradients and purple surfaces',
    now: 'Flat purple, only on actions and status',
    why: 'Keeps the brand without gradients. Saturation drives arousal more than hue.',
    seen: 'Quizlet, Duolingo: flat brand on key actions',
  },
  {
    area: 'Contrast',
    delivered: 'Button 4.44:1 on gradient, nav outline 2.20:1',
    now: 'Light: button passes. Dark: 4.44:1. Nav 3.09:1, body 7:1',
    why: 'Higher contrast across the board. Dark fix is lightness, not hue.',
    seen: 'WCAG AA, AAA for body text',
  },
  {
    area: 'Surfaces',
    delivered: 'Four one-off card styles',
    now: 'One content surface, one brand card',
    why: 'Fewer styles to build, test, and keep consistent.',
    seen: '8 of 8 finance apps sampled: white cards on grey',
  },
  {
    area: 'Theme',
    delivered: 'Dark only',
    now: 'Dark and light from one switch',
    why: 'Easy switch because tokens are layered. Dark blue and black blur with age.',
    seen: 'Quizlet, Rocket Money: light by default',
  },
];

const takeaways = {
  worked: [
    'Meeting often, so decisions didn’t stall',
    'Building fast with Figma’s agent and Claude',
    'Componentizing early. When blue became purple after delivery, it was a token change, not a redesign',
  ],
  hard: [
    'Reviews competed with the CEO’s live client meetings',
    'Aligning on brand: logo size, and dark mode before light',
    'No budget for user research. Market review and two scam experts helped, but it’s not the same',
  ],
  next: [
    'First bank deal was signed post handoff',
    'Full app IA review and redesign at page level',
    'Usability testing, starting with setup',
    'Open up to trial and paid direct users',
  ],
};
---
<CaseStudy
  case={c}
  intro="A bank-distributed app that catches scam messages before people act on them. Brought in mid-build to audit the live product, rebuild onboarding for real activation paths, and tighten home, learning, and the system behind them."
  meta={[
    { key: 'ROLE', value: 'Product Design Lead' },
    { key: 'CLIENT', value: 'RangersAI' },
    { key: 'SCOPE', value: 'A11y, system, onboarding, home, learning' },
  ]}
  credentials={['Bank-contract timeline', 'No research budget', 'B2C + B2B paths']}
  heroAlt="ScamRanger mobile product"
  problem="Inherited a live app with no docs, no style guide, and screens that weren’t frames. Accessibility, activation sequencing, and visual consistency weren’t ready for a bank pilot."
  outcome="Design approved for first-client testing with a major bank. First bank deal signed post handoff. Proposed a calmer dark/light system for the next pass."
>
  <section class="sec">
    <div class="sec-label">THE CONTEXT</div>
    <h2 class="sec-heading">Stopping scams before they start.</h2>
    <p class="sec-body">
      Cybercriminals exploit messaging platforms. Victims turn to banks. Banks absorb deposit losses,
      ops cost, and reimbursement pressure. ScamRanger is sold white-labeled to banks and fintechs—
      the job is to break the cycle early, before emotional manipulation takes hold.
    </p>
    <div class="case-grid-3 sr-findings" style="margin-top:22px">
      <div class="case-card">
        <div class="case-card-label">1 in 4 Americans</div>
        <div class="case-card-body">Scammed at some point in adult life.</div>
      </div>
      <div class="case-card">
        <div class="case-card-label">$442B / year</div>
        <div class="case-card-body">Global cost of scams (Global Anti-Scam Alliance, 2025).</div>
      </div>
      <div class="case-card">
        <div class="case-card-label">Best lever: early</div>
        <div class="case-card-body">Catch the message before the victim responds. Much harder after money moves.</div>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="sec-label">THE AUDIT</div>
    <h2 class="sec-heading">Pitched with an audit. Mapped what was actually broken.</h2>
    <p class="sec-body">
      Brought in via referral to advise the CEO and product. The app was live; the files had no documentation,
      no style guide, and groups instead of frames. I mapped the entire onboarding and activation flow in one place,
      annotated every screen, and categorized issues so the team could prioritize.
    </p>

    <figure class="sr-frame">
      <img src="/images/scamranger/audit-annotated.png" alt="Annotated activation email and onboarding carousel with critique notes" width="3600" height="2154" loading="lazy" />
      <figcaption>Activation email + carousel: trust, sequencing, and screen-level critiques.</figcaption>
    </figure>

    <figure class="sr-frame">
      <img src="/images/scamranger/audit-annotated-2.png" alt="Annotated activation and permissions setup flow with critique notes" width="3600" height="1736" loading="lazy" />
      <figcaption>Activation + setup: code entry, permissions, and settings annotated in place.</figcaption>
    </figure>

    <div class="case-grid-3 sr-findings" style="margin-top:22px">
      <div class="case-card">
        <div class="case-card-label">9 accessibility</div>
        <div class="case-card-body">Contrast, missing labels, form UX, tap targets under 44pt, body under 18px.</div>
      </div>
      <div class="case-card">
        <div class="case-card-label">12 flow logic</div>
        <div class="case-card-body">Redundancy, weak feedback, error states, leave-the-app friction on core setup.</div>
      </div>
      <div class="case-card">
        <div class="case-card-label">9 visual consistency</div>
        <div class="case-card-body">Off-system gradients, mixed structure, tone, and headers across screens.</div>
      </div>
    </div>

    <div class="sr-phones sr-phones--audit" aria-label="Production screens from the audit">
      <figure class="sr-phone">
        <img src="/images/scamranger/audit-screen-1.png" alt="Production home before redesign" width="402" height="874" loading="lazy" />
      </figure>
      <figure class="sr-phone">
        <img src="/images/scamranger/audit-screen-2.png" alt="Suspicious email used in a scan" width="402" height="874" loading="lazy" />
      </figure>
      <figure class="sr-phone">
        <img src="/images/scamranger/audit-screen-3.png" alt="Production verify-message screen" width="402" height="874" loading="lazy" />
      </figure>
      <figure class="sr-phone">
        <img src="/images/scamranger/audit-screen-4.png" alt="Production high-risk analysis result" width="402" height="874" loading="lazy" />
      </figure>
    </div>
    <p class="sr-audit-cap">Production UI from the review: hierarchy, contrast, and tap targets.</p>
  </section>

  <section class="sec">
    <div class="sec-label">PATHS &amp; ITERATION</div>
    <h2 class="sec-heading">Three paths, one shared setup core.</h2>
    <p class="sec-body">
      Production forced everyone through one linear path. The redesign splits B2C purchase, B2B code/QR, and seeded/auto,
      then shares setup downstream—mapped to NN/g’s onboarding model (Promotion → Customize → Instructions).
      Lo-fi locked structure before color. Reviews with the CEO and scam advisor pushed value earlier, kept a dedicated
      T&amp;C for bank consent, and required permission context before leaving the app. Scope grew from flow fixes to
      hi-fi, a dark-mode style guide, and a full rebrand from blue to purple.
    </p>

    <div class="sr-ia">
      <figure class="sr-frame sr-ia-chart">
        <img src="/images/scamranger/ia-flowchart.png" alt="Color-coded onboarding decision flowchart for B2C and B2B paths" loading="lazy" />
        <figcaption>Proposed IA: blue B2C, purple B2B code/QR, pink seeded, gray shared.</figcaption>
      </figure>
      <div class="sr-ia-paths">
        <div class="case-card accent">
          <div class="case-card-label">B2C purchase</div>
          <div class="case-card-body">Gallery → account → paywall → shared setup.</div>
        </div>
        <div class="case-card">
          <div class="case-card-label">B2B code / QR</div>
          <div class="case-card-body">Code or scan → provider confirm → shared setup.</div>
        </div>
        <div class="case-card">
          <div class="case-card-label">B2B seeded</div>
          <div class="case-card-body">Auto-confirmed provider → shared setup. No code step.</div>
        </div>
      </div>
    </div>

    <div class="sr-phones sr-phones--lofi" aria-label="Lo-fi B2B with QR wireframes">
      <figure class="sr-phone sr-phone--lofi">
        <img src="/images/scamranger/lofi-02.png" alt="Lo-fi activation confirmation" width="402" height="874" loading="lazy" />
      </figure>
      <figure class="sr-phone sr-phone--lofi">
        <img src="/images/scamranger/lofi-04.png" alt="Lo-fi setup overview" width="402" height="874" loading="lazy" />
      </figure>
      <figure class="sr-phone sr-phone--lofi">
        <img src="/images/scamranger/lofi-05.png" alt="Lo-fi message filtering setup" width="402" height="874" loading="lazy" />
      </figure>
      <figure class="sr-phone sr-phone--lofi">
        <img src="/images/scamranger/lofi-09.png" alt="Lo-fi first-run home intro" width="402" height="874" loading="lazy" />
      </figure>
    </div>
    <p class="sr-audit-cap">Lo-fi sample: activation, setup overview, filtering, first-run home. Structure before polish.</p>
  </section>

  <section class="sec">
    <div class="sec-label">FLOW 01 / Onboarding</div>
    <h2 class="sec-heading">Three paths in hi-fi. Same shared middle.</h2>
    <p class="sec-body">
      Featured here is the B2C purchase route: value screens, account, trial-first paywall with Apple Pay, then setup.
      B2B code and seeded branches differ only at entry—confirmation with bank branding, then the same permission
      sequence and success screen.
    </p>
    <div class="sr-phones" aria-label="B2C onboarding screens">
      <figure class="sr-phone sr-phone--gallery" data-sr-gallery aria-label="Onboarding gallery, auto-advancing through three slides">
        <div class="sr-gallery-track">
          {gallerySlides.map((s, i) => (
            <img
              src={s.src}
              alt={s.alt}
              width="402"
              height="874"
              loading={i === 0 ? 'eager' : 'lazy'}
              class:list={[{ 'is-active': i === 0 }]}
              data-gallery-slide
            />
          ))}
        </div>
      </figure>

      <figure class="sr-phone">
        <img src="/images/scamranger/onb-account.png" alt="Create your account with inline terms" width="402" height="874" loading="lazy" />
      </figure>

      <figure class="sr-phone sr-phone--paywall" data-sr-paywall aria-label="Paywall purchase flow">
        <video
          class="sr-paywall-video"
          src="/images/scamranger/onb-paywall.mp4"
          poster="/images/scamranger/onb-paywall.png"
          width="402"
          height="874"
          muted
          playsinline
          loop
          preload="metadata"
          aria-label="Subscription paywall"
        ></video>
      </figure>

      <figure class="sr-phone">
        <img src="/images/scamranger/onb-setup.png" alt="Setup intro checklist" width="402" height="874" loading="lazy" />
      </figure>
    </div>
  </section>

  <section class="sec">
    <div class="sec-label">FLOW 02 / Home, scan</div>
    <h2 class="sec-heading">Home: the biggest changes.</h2>
    <p class="sec-body">
      Six moves that mattered. Live app stacked tip and bank notice with no hierarchy. I pushed a gamified quest
      concept; structure settled on tip, scan, bank notice. CEO approved a denser pass—the bank found it too busy.
      Brand came back as a logo with no job; final pass makes the logo the status. Scan stays the primary action.
    </p>
    <div class="sr-home-steps" aria-label="Home iteration stages">
      <div class="sr-home-step">
        <div class="case-card-label">01 Live app</div>
        <div class="case-card-body">Tip and bank notice, no hierarchy</div>
      </div>
      <div class="sr-home-step">
        <div class="case-card-label">02 Quest concept</div>
        <div class="case-card-body">Gamified: quests, streaks, alerts</div>
      </div>
      <div class="sr-home-step">
        <div class="case-card-label">03 Structure set</div>
        <div class="case-card-body">Tip, scan, bank notice, extras</div>
      </div>
      <div class="sr-home-step">
        <div class="case-card-label">04 CEO approved</div>
        <div class="case-card-body">Bank found it too busy</div>
      </div>
      <div class="sr-home-step">
        <div class="case-card-label">05 Brand back in</div>
        <div class="case-card-body">A big logo with no job</div>
      </div>
      <div class="sr-home-step">
        <div class="case-card-label">06 Final</div>
        <div class="case-card-body">The logo becomes the status</div>
      </div>
    </div>
    <div class="sr-compare sr-compare--dirs" aria-label="Home iteration paths: structure, bank trust, and final">
      <div class="sr-compare-item">
        <figure class="sr-phone">
          <img src="/images/scamranger/home-before.png" alt="Live app home before redesign with tip and bank notice stacked" width="402" height="874" loading="lazy" />
        </figure>
        <p class="sr-compare-cap">Live app: tip + bank, no hierarchy</p>
      </div>
      <div class="sr-compare-item">
        <figure class="sr-phone">
          <img src="/images/scamranger/home-iter1.png" alt="Structure-set home with tip, scan card, and bank notice" width="402" height="874" loading="lazy" />
        </figure>
        <p class="sr-compare-cap">Structure set → CEO pass (bank: too busy)</p>
      </div>
      <div class="sr-compare-item">
        <figure class="sr-phone">
          <img src="/images/scamranger/home.png" alt="Final home with logo as status, tip without dismiss, and scan CTA" width="402" height="874" loading="lazy" />
        </figure>
        <p class="sr-compare-cap">Final: logo becomes the status</p>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="sec-label">FLOW 03 / Learning Lab</div>
    <h2 class="sec-heading">The bigger pitch, then simple.</h2>
    <p class="sec-body">
      Learning was a new ask from the bank. I proposed a richer surface: editorial hub, favorites, Scam Library,
      and illustrated insight articles. Time and budget pushed the ship version down to three sections the team
      could build and maintain—Safety insights, Common scam types, and Skill builder. Richer content vs. three
      simple sections that still do the job.
    </p>
    <div class="sr-compare sr-compare--learn" aria-label="Learning proposed versus delivered">
      <div class="sr-compare-item">
        <figure class="sr-phone">
          <img src="/images/scamranger/learn-vision.png" alt="Proposed learning hub: Outsmart every Scam with categories and favorites" width="402" height="874" loading="lazy" />
        </figure>
        <p class="sr-compare-cap">Proposed: Outsmart every Scam</p>
      </div>
      <div class="sr-compare-item">
        <figure class="sr-phone">
          <img src="/images/scamranger/learn-hub-2.png" alt="Proposed Scam Library with article quiz and story filters" width="402" height="874" loading="lazy" />
        </figure>
        <p class="sr-compare-cap">Proposed: Scam Library</p>
      </div>
      <div class="sr-compare-item">
        <figure class="sr-phone">
          <img src="/images/scamranger/learn-hub-3.png" alt="Proposed insight article: Why awareness helps" width="402" height="874" loading="lazy" />
        </figure>
        <p class="sr-compare-cap">Proposed: Why awareness helps</p>
      </div>
      <div class="sr-compare-item">
        <figure class="sr-phone">
          <img src="/images/scamranger/learn-hub.png" alt="Delivered Learning lab hub with three category cards" width="402" height="874" loading="lazy" />
        </figure>
        <p class="sr-compare-cap">Shipped: three simple sections</p>
      </div>
      <div class="sr-compare-item">
        <figure class="sr-phone">
          <img src="/images/scamranger/learn-vision-2.png" alt="Delivered Safety insights educational screen" width="402" height="874" loading="lazy" />
        </figure>
        <p class="sr-compare-cap">Shipped: Safety insights</p>
      </div>
      <div class="sr-compare-item">
        <figure class="sr-phone">
          <img src="/images/scamranger/learn-vision-3.png" alt="Delivered Scam Types alphabetical directory" width="402" height="874" loading="lazy" />
        </figure>
        <p class="sr-compare-cap">Shipped: Scam types A–Z</p>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="sec-label">PROPOSED SYSTEM</div>
    <h2 class="sec-heading">Then the style changed again.</h2>
    <p class="sec-body">
      Once Home and Learning were in, pulling every component into one library showed a problem: everything was purple—
      canvas, cards, even body text. Strong saturation raises arousal, the opposite of what an anxious user needs.
      Eight of eight finance apps sampled use white cards on a grey canvas. The proposed direction (mocked in the system,
      not shipped) moves brand purple onto actions and status only, and gets dark and light from one variable switch—
      not redrawn screens.
    </p>

    <div class="case-grid-3 sr-findings" style="margin-top:22px">
      <div class="case-card">
        <div class="case-card-label">01 Saturation</div>
        <div class="case-card-body">Everything purple left no neutral ground, so nothing stood out.</div>
      </div>
      <div class="case-card">
        <div class="case-card-label">02 Emotion</div>
        <div class="case-card-body">Saturation drives arousal more than hue—wrong for a scary-message moment.</div>
      </div>
      <div class="case-card">
        <div class="case-card-label">03 One switch</div>
        <div class="case-card-body">Light mode from layered tokens. Same screens, mode on the frame.</div>
      </div>
    </div>

    <div class="sr-rationale" style="margin-top:22px">
      <div class="sr-panel-head">
        <h3 class="sr-panel-title">What changed, and why</h3>
        <p class="sr-panel-lede">Delivered vs. proposed. Every row ties to a standard, a study, or a pattern people already use—and calls out what isn’t tested.</p>
      </div>
      <div class="sr-rationale-table" role="table" aria-label="Design rationale: delivered versus proposed">
        <div class="sr-rationale-head" role="row">
          <span role="columnheader">Area</span>
          <span role="columnheader">Delivered</span>
          <span role="columnheader">Now</span>
          <span role="columnheader">Why</span>
          <span role="columnheader">Seen in</span>
        </div>
        {rationale.map((r) => (
          <div class="sr-rationale-row" role="row">
            <span class="sr-rationale-area" role="cell" data-label="Area">{r.area}</span>
            <span role="cell" data-label="Delivered">{r.delivered}</span>
            <span role="cell" data-label="Now">{r.now}</span>
            <span role="cell" data-label="Why">{r.why}</span>
            <span class="sr-rationale-seen" role="cell" data-label="Seen in">{r.seen}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="sec" style="padding-bottom:28px">
    <div class="sec-label">DESIGN SYSTEM / Snapshot</div>
    <h2 class="sec-heading">A slice of the system that made the rebrand cheap.</h2>
    <p class="sec-body">
      Sofia Pro on a scale with an 18px content floor. Tokens, a few core components, and the rules that mattered for handoff.
      Componentizing early meant blue → purple after delivery was a token change, not a redesign. Snapshot of the delivered
      dark system—not every state, and not the full proposed light/dark library.
    </p>

    <div class="sr-notebook" data-sr-notebook>
      <div class="sr-notebook-chrome">
        <div class="sr-notebook-title">
          <span class="sr-notebook-dot" aria-hidden="true"></span>
          ScamRanger system snapshot
        </div>
        <div class="sr-notebook-tabs" role="tablist" aria-label="Design system sections">
          <button type="button" class="sr-tab is-active" role="tab" aria-selected="true" data-tab="styles">Styles</button>
          <button type="button" class="sr-tab" role="tab" aria-selected="false" data-tab="components">Components</button>
          <button type="button" class="sr-tab" role="tab" aria-selected="false" data-tab="guidelines">Guidelines</button>
        </div>
      </div>

      <div class="sr-notebook-body">
        <div class="sr-panel is-active" role="tabpanel" data-panel="styles">
          <div class="sr-panel-head">
            <h3 class="sr-panel-title">Color &amp; type</h3>
            <p class="sr-panel-lede">Delivered dark tokens. Content floor is 18. Background runs a 221° gradient across the bg values.</p>
          </div>
          <div class="sr-color-grid">
            {colors.map((t) => (
              <div class="sr-color">
                <span class="sr-color-swatch" style={`background:${t.hex}`}></span>
                <div>
                  <div class="sr-color-name">{t.name}</div>
                  <div class="sr-color-meta">{t.hex}, {t.use}</div>
                </div>
              </div>
            ))}
          </div>
          <div class="sr-type-list">
            {typeScale.map((t) => (
              <div class="sr-type-row">
                <span class="sr-type-name">{t.name}</span>
                <span class="sr-type-spec">{t.spec}</span>
              </div>
            ))}
          </div>
        </div>

        <div class="sr-panel" role="tabpanel" data-panel="components" hidden>
          <div class="sr-panel-head">
            <h3 class="sr-panel-title">Core components</h3>
            <p class="sr-panel-lede">Five building blocks used across onboarding and the app. Live CSS, no screenshots.</p>
          </div>

          <div class="sr-comp-stack">
            <div class="sr-comp-block">
              <h4 class="sr-comp-name">Button</h4>
              <div class="sr-comp-live">
                <div class="sr-demo-row">
                  <span class="sr-demo-label">Default</span>
