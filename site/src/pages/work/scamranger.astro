---
/**
 * ScamRanger case study — styled to match Enterprise Permissions,
 * content and frames from the portfolio-review Figma slides.
 */
import CaseStudy from '../../layouts/CaseStudy.astro';
import { cases } from '../../data/cases';

const c = cases.find((x) => x.slug === 'scamranger')!;
const next = cases.find((x) => x.slug === 'myintake')!;
const nextHref = `/work/${next.slug}/`;

const gallerySlides = [
  { src: '/images/scamranger/onb-gallery.png', alt: 'Gallery slide: scams are everywhere' },
  { src: '/images/scamranger/onb-gallery-2.png', alt: 'Gallery slide: stay protected' },
  { src: '/images/scamranger/onb-gallery-3.png', alt: 'Gallery slide: trusted by institutions' },
];

const topMetrics = [
  { label: 'AUDIT', stat: '30', body: 'issues categorized across a11y, flow, and visuals.' },
  { label: 'PATHS', stat: '3', body: 'entry types sharing one setup core.' },
  { label: 'OUTCOME', stat: '1st', body: 'bank deal signed post handoff.' },
];

const opener = {
  constraint: 'Timeline tied to a bank contract, no research budget, and an inherited live app with no documentation or style guide.',
  problem: 'Accessibility, activation sequencing, and visual consistency weren’t ready for a bank pilot. Paths mixed B2C and B2B into one linear flow.',
  outcome: 'Design approved for first-client testing. First bank deal signed post handoff. Proposed a calmer dark/light system for the next pass.',
};

const auditFindings = [
  { label: '9 ACCESSIBILITY', text: 'Contrast failures, missing labels, form UX gaps, tap targets under 44pt, body under 18px.' },
  { label: '12 FLOW LOGIC', text: 'Redundancy, weak feedback, error states, leave-the-app friction on core message-filtering setup.' },
  { label: '9 VISUAL CONSISTENCY', text: 'Off-system gradients, mixed structure, tone, and headers across screens.' },
];

const paths = [
  { label: 'B2C PURCHASE', text: 'Gallery → account → trial-first paywall → shared setup.' },
  { label: 'B2B CODE / QR', text: 'Code or scan → provider confirm → shared setup.' },
  { label: 'B2B SEEDED', text: 'Auto-confirmed provider → shared setup. No code step.' },
];

const homeSteps = [
  { n: '01', title: 'Live app', text: 'Tip and bank notice, no hierarchy' },
  { n: '02', title: 'Quest concept', text: 'Gamified: quests, streaks, alerts' },
  { n: '03', title: 'Structure set', text: 'Tip, scan, bank notice, extras' },
  { n: '04', title: 'CEO approved', text: 'Bank found it too busy' },
  { n: '05', title: 'Brand back in', text: 'A big logo with no job' },
  { n: '06', title: 'Final', text: 'The logo becomes the status' },
];

const systemPoints = [
  { label: '01 SATURATION', text: 'Everything was purple: canvas, cards, even body text. No neutral ground.' },
  { label: '02 EMOTION', text: 'Strong color raises arousal—the opposite of what an anxious user needs.' },
  { label: '03 PATTERN', text: '8 of 8 finance apps sampled use white cards on a grey canvas.' },
  { label: '04 ONE SWITCH', text: 'Light mode from layered tokens, not redrawn screens.' },
];

const rationale = [
  {
    area: 'Home',
    delivered: 'Opens on content: tip, scan, bank block, links',
    now: 'Opens on “am I safe?”, then recent checks',
    why: 'Answers the question people open the app with. Untested with users.',
    seen: 'Rocket Money: summary first, then recent activity',
  },
  {
    area: 'Type',
    delivered: 'Body 16–18, nav labels 11',
    now: 'Body 18 throughout, titles 22, nav 13',
    why: 'People in their 40s already need larger type (NN/g).',
    seen: 'Apple HIG: 17pt body by default',
  },
  {
    area: 'Touch targets',
    delivered: 'Rows ~72pt, nav ~56pt, links inline',
    now: 'Rows 76–80pt, buttons 60–64pt, tabs 75pt',
    why: 'About 1 in 5 over-65s has some tremor (W3C).',
    seen: 'Apple HIG: 44pt minimum',
  },
  {
    area: 'Color',
    delivered: 'Brand carried by gradients and purple surfaces',
    now: 'Flat purple, only on actions and status',
    why: 'Keeps the brand without gradients. Saturation drives arousal more than hue.',
    seen: 'Quizlet, Duolingo: flat brand on key actions',
  },
  {
    area: 'Contrast',
    delivered: 'Button 4.44:1 on gradient, nav outline 2.20:1',
    now: 'Light: button passes. Dark: 4.44:1. Nav 3.09:1, body 7:1',
    why: 'Higher contrast across the board. Dark fix is lightness, not hue.',
    seen: 'WCAG AA, AAA for body text',
  },
  {
    area: 'Surfaces',
    delivered: 'Four one-off card styles',
    now: 'One content surface, one brand card',
    why: 'Fewer styles to build, test, and keep consistent.',
    seen: '8 of 8 finance apps sampled: white cards on grey',
  },
  {
    area: 'Theme',
    delivered: 'Dark only',
    now: 'Dark and light from one switch',
    why: 'Easy switch because tokens are layered. Dark blue and black blur with age.',
    seen: 'Quizlet, Rocket Money: light by default',
  },
];

const typeScale = [
  { name: 'Display', spec: '48 / 125, Regular' },
  { name: 'H1', spec: '34 / 125, Medium' },
  { name: 'H2', spec: '28 / 162, Medium' },
  { name: 'H3', spec: '22 / 150, Medium' },
  { name: 'Body Large', spec: '20 / 165, Regular' },
  { name: 'Body', spec: '18 / 165, Regular' },
  { name: 'UI Button', spec: '18 / 125, Semibold' },
];

const colors = [
  { name: 'brand/primary', hex: '#7B5CF8', use: 'Primary action' },
  { name: 'brand/medium', hex: '#9B85FF', use: 'Press, links' },
  { name: 'brand/light', hex: '#C9BDFF', use: 'Text tints' },
  { name: 'brand/dark', hex: '#5533CC', use: 'Disabled' },
  { name: 'bg/start', hex: '#2E1B6E', use: 'Gradient 0%' },
  { name: 'bg/end', hex: '#08052A', use: 'Gradient 100%' },
  { name: 'text/primary', hex: '#FFFFFF', use: 'Body, labels' },
  { name: 'status/error', hex: '#FF8080', use: 'Errors' },
];

const guidelines = [
  { title: '18px body floor', text: 'Real content never drops below 18. 14px only for chrome like field labels.' },
  { title: '44px+ tap targets', text: 'Buttons, rows, and nav meet Apple HIG / WCAG touch guidance.' },
  { title: 'Solid color, not opacity', text: 'Solid tokens only. Opacity washes over gradients made contrast unreliable.' },
  { title: 'Dedicated T&C for banks', text: 'Partnerships need explicit consent—not buried next to a secondary action.' },
  { title: 'Permission with context', text: 'Explain why each setting matters before sending someone into iOS Settings.' },
];

const learnings = [
  'Meeting often kept decisions moving when reviews competed with live client meetings.',
  'Componentizing early meant blue → purple after delivery was a token change, not a redesign.',
  'Without a research budget, market review and two scam experts helped—but usability testing still has to come next.',
];
---
<CaseStudy
  case={c}
  intro="Clear design to protect targeted users. A bank-distributed scam-protection app—audited mid-build, rebuilt for real activation paths, then tightened across home, learning, and the system behind them."
  meta={[
    { key: 'ROLE', value: 'Product Design Lead' },
    { key: 'CLIENT', value: 'RangersAI' },
    { key: 'TIMELINE', value: '2026' },
    { key: 'SCOPE', value: 'A11y · system · onboarding · home · learning' },
  ]}
  heroAlt="ScamRanger mobile product"
  problem={opener.problem}
  outcome={opener.outcome}
  hideOpener
>
  <section class="sr-top">
    <div class="sr-metric-row">
      {topMetrics.map((m) => (
        <div class="sr-metric">
          <div class="sr-metric-label">{m.label}</div>
          <div class="sr-metric-stat">{m.stat}</div>
          <div class="sr-metric-body">{m.body}</div>
        </div>
      ))}
    </div>

    <div class="sr-context-split">
      <div class="sr-context-main">
        <div class="sec-label">THE CONTEXT</div>
        <h2 class="sec-heading">A bank-distributed app that catches scam messages before people act on them.</h2>
        <p class="sec-body">
          RangersAI’s product is sold white-labeled to banks and fintechs. Cybercriminals exploit messaging;
          victims turn to banks; banks absorb losses and reimbursement pressure. The job is to break the cycle
          early—before emotional manipulation takes hold.
        </p>
        <p class="sr-context-partner">Partnered with CEO, scam research advisor (PhD), Android and iOS developers.</p>
      </div>
      <div class="sr-context-side">
        <div class="sr-po-card">
          <div class="sr-po-label">THE CONSTRAINT</div>
          <p>{opener.constraint}</p>
        </div>
        <div class="sr-po-card">
          <div class="sr-po-label">THE PROBLEM</div>
          <p>{opener.problem}</p>
        </div>
        <div class="sr-po-card">
          <div class="sr-po-label">THE OUTCOME</div>
          <p>{opener.outcome}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="sec sr-band">
    <div class="sec-label">THE COMPANY</div>
    <h2 class="sec-heading">Stopping scams before they start.</h2>
    <p class="sec-body">
      1 in 4 Americans scammed in adult life. Global cost surpassed $442B/year. Best potential to protect users
      is at the incoming message—much harder once money has moved.
    </p>
    <figure class="case-fig sr-deck">
      <img src="/images/scamranger/deck/04-company.png" alt="Scam lifecycle diagram: stop early before emotional manipulation and money transfer" loading="lazy" />
      <figcaption>Problem space from the portfolio review: catch the message before the victim responds</figcaption>
    </figure>
  </section>

  <section class="sec">
    <div class="sec-label">THE HANDOFF</div>
    <h2 class="sec-heading">Brought in via referral to advise CEO and product.</h2>
    <p class="sec-body">
      The app was live. The design files had no documentation, no style guide, and groups instead of frames.
      I pitched for the role with an audit of the live onboarding and activation flow.
    </p>
    <figure class="case-fig sr-deck">
      <img src="/images/scamranger/deck/05-handoff.png" alt="State of handoff: production screens with no documentation, style guide, or frames" loading="lazy" />
      <figcaption>Inherited state: live product, loose groups, no system</figcaption>
    </figure>
    <figure class="case-fig sr-deck">
      <img src="/images/scamranger/deck/03-snapshot.png" alt="Project snapshot: role, team, scope, and constraints next to ScamRanger home screen" loading="lazy" />
      <figcaption>Snapshot: Product Design Lead · a11y, system, onboarding, home, learning</figcaption>
    </figure>
  </section>

  <section class="sec sr-band">
    <div class="sec-label">THE AUDIT</div>
    <h2 class="sec-heading">Pitched with an audit. Mapped what was actually broken.</h2>
    <p class="sec-body">
      First job was making the app visible: the entire live onboarding and activation flow in one place, with
      annotations on every screen. Issues categorized by type and priority so the team could act.
    </p>

    <figure class="case-fig sr-deck">
      <img src="/images/scamranger/deck/06-audit.png" alt="Annotated ScamRanger onboarding audit with accessibility, flow, and visual findings" loading="lazy" />
      <figcaption>Full onboarding audit board used to pitch for the role</figcaption>
    </figure>

    <div class="case-grid-3 sr-findings">
      {auditFindings.map((f) => (
        <div class="case-card">
          <div class="case-card-label">{f.label}</div>
          <div class="case-card-body">{f.text}</div>
        </div>
      ))}
    </div>

    <h3 class="sec-subhead">One screen up close: message filtering setup</h3>
    <p class="sec-body">
      Marked P1 because filtering is the product. If it isn’t turned on, nobody is protected. iOS forces users
      out of the app; the live screen buried steps in a fast video, used jargon breadcrumbs, and failed contrast
      and tap-target checks.
    </p>
    <figure class="case-fig sr-deck">
      <img src="/images/scamranger/deck/07-audit-example.png" alt="Filtering setup screen annotated with eight accessibility and flow issues" loading="lazy" />
      <figcaption>Example critique: leave-the-app friction, video-only steps, contrast, and tap targets</figcaption>
    </figure>

    <h3 class="sec-subhead">Production UI from the review</h3>
    <div class="sr-phones sr-phones--audit" aria-label="Production screens from the audit">
      <figure class="sr-phone">
        <img src="/images/scamranger/audit-screen-1.png" alt="Production home before redesign" width="402" height="874" loading="lazy" />
      </figure>
      <figure class="sr-phone">
        <img src="/images/scamranger/audit-screen-2.png" alt="Suspicious email used in a scan" width="402" height="874" loading="lazy" />
      </figure>
      <figure class="sr-phone">
        <img src="/images/scamranger/audit-screen-3.png" alt="Production verify-message screen" width="402" height="874" loading="lazy" />
      </figure>
      <figure class="sr-phone">
        <img src="/images/scamranger/audit-screen-4.png" alt="Production high-risk analysis result" width="402" height="874" loading="lazy" />
      </figure>
    </div>
  </section>

  <section class="sec">
    <div class="sec-label">PATHS &amp; STRUCTURE</div>
    <h2 class="sec-heading">Three paths, one shared setup core.</h2>
    <p class="sec-body">
      Production forced everyone through one linear path. The redesign splits B2C, B2B code/QR, and seeded entry,
      then shares setup downstream—mapped to NN/g’s onboarding model (Promotion → Customize → Instructions).
    </p>

    <figure class="case-fig sr-deck">
      <img src="/images/scamranger/deck/08-flow-restructure.png" alt="Flow restructuring: existing broken state versus code path, QR path, and unified IA diagram" loading="lazy" />
      <figcaption>From broken linear flow to color-coded B2C / B2B / shared architecture</figcaption>
    </figure>

    <div class="case-grid-3 sr-findings">
      {paths.map((p) => (
        <div class="case-card">
          <div class="case-card-label">{p.label}</div>
          <div class="case-card-body">{p.text}</div>
        </div>
      ))}
    </div>

    <h3 class="sec-subhead">Early drafting, then structure in grey</h3>
    <p class="sec-body">
      Market references and quick mockups to move fast, then wireframes locked step order before polish.
      Feedback rounds separated flow, annotated screens, and hi-fi so nobody stalled on color before structure agreed.
    </p>
    <figure class="case-fig sr-deck">
      <img src="/images/scamranger/deck/09-early-drafting.png" alt="Early drafting board with screenshots, AI mockups, and reference wireframes" loading="lazy" />
      <figcaption>Screenshots, AI mockups, and reference patterns from Calm, Headspace, and similar apps</figcaption>
    </figure>
    <figure class="case-fig sr-deck">
      <img src="/images/scamranger/deck/10-wireframes.png" alt="Grey wireframes for B2C and B2B onboarding paths with numbered change callouts" loading="lazy" />
      <figcaption>Lo-fi: value before asks, plain-language settings, three ways in, one permission per screen</figcaption>
    </figure>

    <figure class="case-fig sr-deck">
      <img src="/images/scamranger/deck/11-after-lofi.png" alt="After first lo-fi: review feedback and cohesive solution notes" loading="lazy" />
      <figcaption>Review notes: value earlier, dedicated T&amp;C, permission context, blue → purple rebrand</figcaption>
    </figure>

    <div class="sr-phones sr-phones--lofi" aria-label="Lo-fi wireframe sample">
      <figure class="sr-phone sr-phone--lofi">
        <img src="/images/scamranger/lofi-02.png" alt="Lo-fi activation confirmation" width="402" height="874" loading="lazy" />
      </figure>
      <figure class="sr-phone sr-phone--lofi">
        <img src="/images/scamranger/lofi-04.png" alt="Lo-fi setup overview" width="402" height="874" loading="lazy" />
      </figure>
      <figure class="sr-phone sr-phone--lofi">
        <img src="/images/scamranger/lofi-05.png" alt="Lo-fi message filtering setup" width="402" height="874" loading="lazy" />
      </figure>
      <figure class="sr-phone sr-phone--lofi">
        <img src="/images/scamranger/lofi-09.png" alt="Lo-fi first-run home intro" width="402" height="874" loading="lazy" />
      </figure>
    </div>
  </section>

  <section class="sec sr-band">
    <div class="sec-label">ONBOARDING</div>
    <h2 class="sec-heading">Three paths in hi-fi. Same shared middle.</h2>
    <p class="sec-body">
      Consumer pays, so value screens and a trial-first paywall come first. Bank code and seeded paths differ only
      at entry—then the same permission sequence and success screen.
    </p>

    <figure class="case-fig sr-deck">
      <img src="/images/scamranger/deck/12-hifi-paths.png" alt="Hi-fidelity onboarding rows for B2C, B2B code, and B2B seeded paths" loading="lazy" />
      <figcaption>Hi-fi flows: three entries, one shared setup</figcaption>
    </figure>

    <h3 class="sec-subhead">B2C purchase route</h3>
    <div class="sr-phones" aria-label="B2C onboarding screens">
      <figure class="sr-phone sr-phone--gallery" data-sr-gallery aria-label="Onboarding gallery, auto-advancing through three slides">
        <div class="sr-gallery-track">
          {gallerySlides.map((s, i) => (
            <img
              src={s.src}
              alt={s.alt}
              width="402"
              height="874"
              loading={i === 0 ? 'eager' : 'lazy'}
              class:list={[{ 'is-active': i === 0 }]}
              data-gallery-slide
            />
          ))}
        </div>
      </figure>
      <figure class="sr-phone">
        <img src="/images/scamranger/onb-account.png" alt="Create your account" width="402" height="874" loading="lazy" />
      </figure>
      <figure class="sr-phone sr-phone--paywall" data-sr-paywall aria-label="Paywall purchase flow">
        <video
          class="sr-paywall-video"
          src="/images/scamranger/onb-paywall.mp4"
          poster="/images/scamranger/onb-paywall.png"
          width="402"
          height="874"
          muted
          playsinline
          loop
          preload="metadata"
          aria-label="Subscription paywall"
        ></video>
      </figure>
      <figure class="sr-phone">
        <img src="/images/scamranger/onb-setup.png" alt="Setup intro checklist" width="402" height="874" loading="lazy" />
      </figure>
    </div>
  </section>

  <section class="sec">
    <div class="sec-label">HOME</div>
    <h2 class="sec-heading">Home: the biggest changes.</h2>
    <p class="sec-body">
      Six moves that mattered—from a flat live stack, through a quest concept and a CEO-approved pass the bank
      rejected as too busy, to a final where the logo becomes the status signal.
    </p>

    <figure class="case-fig sr-deck">
      <img src="/images/scamranger/deck/14-home-iterations.png" alt="Six home screen iterations from live app through quest concept to final dark and light" loading="lazy" />
      <figcaption>Iteration arc: live → quest → structure → CEO → brand → final (dark + light)</figcaption>
    </figure>

    <div class="sr-home-steps" aria-label="Home iteration stages">
      {homeSteps.map((s) => (
        <div class="sr-home-step">
          <div class="case-card-label">{s.n} · {s.title}</div>
          <div class="case-card-body">{s.text}</div>
        </div>
      ))}
    </div>

    <div class="sr-compare sr-compare--dirs" aria-label="Home before, mid, and final">
      <div class="sr-compare-item">
        <figure class="sr-phone">
          <img src="/images/scamranger/home-before.png" alt="Live app home before redesign" width="402" height="874" loading="lazy" />
        </figure>
        <p class="sr-compare-cap">Live app: tip + bank, no hierarchy</p>
      </div>
      <div class="sr-compare-item">
        <figure class="sr-phone">
          <img src="/images/scamranger/home-iter1.png" alt="Structure-set home iteration" width="402" height="874" loading="lazy" />
        </figure>
        <p class="sr-compare-cap">Structure set → CEO pass (bank: too busy)</p>
      </div>
      <div class="sr-compare-item">
        <figure class="sr-phone">
          <img src="/images/scamranger/home.png" alt="Final home with logo as status" width="402" height="874" loading="lazy" />
        </figure>
        <p class="sr-compare-cap">Final: logo becomes the status</p>
      </div>
    </div>
  </section>

  <section class="sec sr-band">
    <div class="sec-label">LEARNING LAB</div>
    <h2 class="sec-heading">The bigger pitch, then simple.</h2>
    <p class="sec-body">
      Learning was a new bank ask. I proposed an editorial hub with favorites, Scam Library, and illustrated articles.
      Time and budget pushed the ship version to three sections the team could build and maintain.
    </p>

    <figure class="case-fig sr-deck">
      <img src="/images/scamranger/deck/15-learning.png" alt="Learning Lab proposed rich hub versus shipped three-section version" loading="lazy" />
      <figcaption>Proposed depth vs. shipped: Safety insights, Common scam types, Skill builder</figcaption>
    </figure>

    <div class="sr-compare sr-compare--learn" aria-label="Learning proposed versus delivered">
      <div class="sr-compare-item">
        <figure class="sr-phone">
          <img src="/images/scamranger/learn-vision.png" alt="Proposed learning hub" width="402" height="874" loading="lazy" />
        </figure>
        <p class="sr-compare-cap">Proposed: Outsmart every Scam</p>
      </div>
      <div class="sr-compare-item">
        <figure class="sr-phone">
          <img src="/images/scamranger/learn-hub-2.png" alt="Proposed Scam Library" width="402" height="874" loading="lazy" />
        </figure>
        <p class="sr-compare-cap">Proposed: Scam Library</p>
      </div>
      <div class="sr-compare-item">
        <figure class="sr-phone">
          <img src="/images/scamranger/learn-hub.png" alt="Delivered Learning Lab hub" width="402" height="874" loading="lazy" />
        </figure>
        <p class="sr-compare-cap">Shipped: three simple sections</p>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="sec-label">PROPOSED SYSTEM</div>
    <h2 class="sec-heading">Then the style changed again.</h2>
    <p class="sec-body">
      Pulling every component into one library showed the problem: everything was purple. The proposed direction—
      mocked in the system, not shipped—moves brand onto actions and status only, and gets dark and light from
      one variable switch.
    </p>

    <figure class="case-fig sr-deck">
      <img src="/images/scamranger/deck/16-new-system.png" alt="Delivered saturated purple home versus proposed light-mode home" loading="lazy" />
      <figcaption>Saturation problem → calmer light canvas with purple on actions only</figcaption>
    </figure>

    <div class="case-grid-2 sr-findings">
      {systemPoints.map((p) => (
        <div class="case-card">
          <div class="case-card-label">{p.label}</div>
          <div class="case-card-body">{p.text}</div>
        </div>
      ))}
    </div>

    <h3 class="sec-subhead">Dark and light, from one switch</h3>
    <figure class="case-fig sr-deck">
      <img src="/images/scamranger/deck/17-proposed-system.png" alt="Proposed system screens in light and dark modes from one token switch" loading="lazy" />
      <figcaption>Proposed direction mocked in the system—not shipped. Same screens, mode on the frame.</figcaption>
    </figure>

    <h3 class="sec-subhead">What changed, and why</h3>
    <p class="sec-body">
      Every row ties to a standard, a study, or a pattern people already use—and calls out what isn’t tested.
    </p>
    <figure class="case-fig sr-deck">
      <img src="/images/scamranger/deck/18-rationale.png" alt="Rationale table comparing delivered versus proposed design decisions" loading="lazy" />
      <figcaption>Delivered → now → why → seen in</figcaption>
    </figure>

    <div class="sr-rationale-table" role="table" aria-label="Design rationale: delivered versus proposed">
      <div class="sr-rationale-head" role="row">
        <span role="columnheader">Area</span>
        <span role="columnheader">Delivered</span>
        <span role="columnheader">Now</span>
        <span role="columnheader">Why</span>
        <span role="columnheader">Seen in</span>
      </div>
      {rationale.map((r) => (
        <div class="sr-rationale-row" role="row">
          <span class="sr-rationale-area" role="cell" data-label="Area">{r.area}</span>
          <span role="cell" data-label="Delivered">{r.delivered}</span>
          <span role="cell" data-label="Now">{r.now}</span>
          <span role="cell" data-label="Why">{r.why}</span>
          <span class="sr-rationale-seen" role="cell" data-label="Seen in">{r.seen}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="sec sr-band">
    <div class="sec-label">DESIGN SYSTEM</div>
