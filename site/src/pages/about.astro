---
import Base from '../layouts/Base.astro';
import AboutSection from '../components/AboutSection.astro';

const availabilityLine =
  'Open to product design roles, full-time or contract. Seattle or remote.';
---

<Base
  title="About · Sam Lucia"
  description="Product designer in Seattle. Complex systems, enterprise tools, and the messy middle between people and platforms."
  width="home"
  footerCopyright
>
  <main class="rpg-about">
    <AboutSection variant="rpg" />

    <section class="section cta-sec" id="contact">
      <a class="cta" href="mailto:samuel.d.lucia@gmail.com">
        <div>
          <h2 class="sec-heading">Let's build something people can actually get through.</h2>
          <p class="cta-lead">{availabilityLine}</p>
        </div>
        <span class="cta-btn">Email</span>
      </a>
    </section>
  </main>
</Base>

<style>
  .rpg-about {
    --section-pad: clamp(48px, 6vw, 64px);
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 0 var(--page-pad-x);
  }

  .rpg-about :global(.sec-heading) {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 32px;
    font-weight: 700;
    letter-spacing: -0.5px;
    line-height: 1.2;
    color: var(--ink);
  }
  .rpg-about :global(.sec-head) {
    margin-bottom: 28px;
  }

  .section {
    padding: var(--section-pad) 0;
    border-top: 1.5px solid #e6e4e0;
  }

  .cta-sec {
    scroll-margin-top: 80px;
  }

  .cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
    padding: 28px 30px;
    border: 2px solid var(--ink);
    border-radius: 12px;
    box-shadow: var(--card-shadow);
    background: #fff;
    color: inherit;
    text-decoration: none;
    cursor: pointer;
  }
  .cta:focus-visible {
    outline: none;
    box-shadow:
      var(--card-shadow),
      0 0 0 3px rgba(124, 227, 139, 0.45);
  }
  .cta .sec-heading {
    max-width: 22ch;
  }
  .cta-lead {
    margin: 10px 0 0;
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.6;
    color: #5c6066;
  }
  .cta-btn {
    flex-shrink: 0;
    display: inline-flex;
    padding: 14px 22px;
    background: var(--gold);
    border: 2px solid var(--ink);
    box-shadow: 3px 3px 0 var(--ink);
    font-family: var(--font-pixel);
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0;
    text-transform: uppercase;
    color: var(--ink);
    transition: transform 0.12s, box-shadow 0.12s;
  }
  .cta:hover .cta-btn,
  .cta:focus-visible .cta-btn {
    transform: translate(2px, 2px);
    box-shadow: 1px 1px 0 var(--ink);
  }

  @media (max-width: 900px) {
    .rpg-about {
      --section-pad: 48px;
    }
    .cta {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
