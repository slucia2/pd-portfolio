---
import '../styles/global.css';
import '../styles/motion.css';

interface Props {
  title: string;
  description?: string;
  /** Page column width preset: nav, footer, and content all follow it */
  width?: 'home' | 'case';
  /** Footer right-side text; use footerCopyright for RPG-style single copyright line */
  footerRight?: string;
  footerCopyright?: boolean;
}

const {
  title,
  width = 'home',
  description = 'Sam Lucia, product designer for the messy middle. Complex systems, enterprise tools · T-Mobile, Seattle.',
  footerRight = 'PRESS START',
  footerCopyright = false,
} = Astro.props;

const { pathname } = Astro.url;
const path = pathname.replace(/\/$/, '') || '/';
const isHome = path === '/';
const isAbout = path === '/about';
/** Case studies only — home Work state is driven by scroll spy below */
const isCase = path.startsWith('/work');
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Space+Grotesk:wght@400;500;700&family=Silkscreen:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/regular/style.css" />
    <link rel="stylesheet" href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/bold/style.css" />
    <script is:inline>
      (function () {
        try {
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            sessionStorage.removeItem('sl-page-enter');
            return;
          }
          if (sessionStorage.getItem('sl-page-enter')) {
            sessionStorage.removeItem('sl-page-enter');
            document.documentElement.classList.add('has-page-enter');
          }
        } catch (e) {}
      })();
    </script>
    {
      isHome && (
        <script is:inline>
          (function () {
            try {
              var nav = performance.getEntriesByType('navigation')[0];
              var isReload = nav && nav.type === 'reload';
              if (isReload || !sessionStorage.getItem('sl-recruiter-scan')) {
                document.documentElement.classList.add('has-recruiter-scan');
                document.documentElement.classList.remove('has-page-enter');
              }
            } catch (e) {
              document.documentElement.classList.add('has-recruiter-scan');
              document.documentElement.classList.remove('has-page-enter');
            }
          })();
        </script>
      )
    }
  </head>
  <body class={`w-${width}`}>
    {
      isHome && (
        <div id="recruiter-scan" class="motion-overlay" aria-hidden="true">
          <div class="motion-field" data-scan-field>
            <div class="scan-stage">
              <div class="scan-header" data-scan-header>
                <div class="scan-frame is-on" data-scan-frame>
                  <span class="scan-frame-text t1">HCI</span>
                </div>
                <div class="scan-frame" data-scan-frame>
                  <span class="scan-frame-text t2">IA</span>
                </div>
                <div class="scan-frame" data-scan-frame>
                  <span class="scan-frame-text t4">Design systems</span>
                </div>
                <div class="scan-frame" data-scan-frame>
                  <span class="scan-frame-text t3">AI Builds</span>
                </div>
                <div class="scan-frame scan-frame--final" data-scan-frame data-scan-final>
                  <span class="scan-final">
                    <span class="scan-final-dot" data-scan-dot aria-hidden="true"></span>
                    <span class="scan-frame-text t-final">Actively applying</span>
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>
      )
    }

    <nav class="nav">
      <a href="/" class="nav-brand">
        <span class="nav-dot"></span>
        <span class="nav-name">Sam Lucia</span>
      </a>
      <div class="nav-links">
        <a href="/#work" data-nav="work" class={isCase ? 'active' : undefined}>Work</a>
        <a href="/about" data-nav="about" class={isAbout ? 'active' : undefined}>About</a>
      </div>
    </nav>

    <slot />

    <footer class="footer">
      {footerCopyright ? (
        <>
          <span class="footer-copy">
            © 2026 Sam Lucia · All rights reserved
            {isHome && (
              <button type="button" class="motion-demo-btn" id="replay-scan" data-replay-scan>
                Replay intro
              </button>
            )}
          </span>
          <span class="footer-mid">Seattle, WA</span>
          <div class="footer-socials">
            <a href="https://www.linkedin.com/in/samlucia" target="_blank" rel="noopener noreferrer"
              >LinkedIn</a
            >
            <a href="https://github.com/slucia2" target="_blank" rel="noopener noreferrer">GitHub</a>
          </div>
        </>
      ) : (
        <>
          <span class="footer-pixel">© 2026 SAM LUCIA</span>
          <span class="footer-mid">Seattle, WA</span>
          <span class="footer-pixel">{footerRight}</span>
        </>
      )}
    </footer>

    <script is:inline>
      (function () {
        var SCAN_KEY = 'sl-recruiter-scan';
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var motionReady = false;
        var leaving = false;

        function signalMotionReady() {
          if (motionReady) return;
          motionReady = true;
          window.dispatchEvent(new CustomEvent('sl:motion-ready'));
        }

        function playDeferredVideos() {
          document.querySelectorAll('video[data-defer-play]').forEach(function (v) {
            try {
              var p = v.play();
              if (p && p.catch) p.catch(function () {});
            } catch (e) {}
          });
        }

        window.addEventListener('sl:motion-ready', playDeferredVideos);

        function scrollToId(id, behavior) {
          var el = document.getElementById(id);
          if (!el) return false;
          el.scrollIntoView({ behavior: behavior || (reduce ? 'auto' : 'smooth'), block: 'start' });
          return true;
        }

        function runRecruiterScan() {
          var pending = document.documentElement.classList.contains('has-recruiter-scan');
          var scan = document.getElementById('recruiter-scan');
          var field = scan && scan.querySelector('[data-scan-field]');
          if (!scan) return false;
          if (!pending) {
            scan.remove();
            return false;
          }
          if (scan.dataset.armed) return true;
          scan.dataset.armed = '1';
          try {
            sessionStorage.setItem(SCAN_KEY, '1');
          } catch (e) {}
          if (reduce) {
            document.documentElement.classList.remove('has-recruiter-scan');
            scan.remove();
            return false;
          }

          var frames = Array.prototype.slice.call(scan.querySelectorAll('[data-scan-frame]'));
          var finalDot = scan.querySelector('[data-scan-dot]');
          var HOLD = 580;
          var SWAP = 180;
          var FINAL_HOLD = 620;
          var i = 0;

          function setWipeTarget() {
            var dot = document.querySelector('.nav-dot');
            var x = '50%';
            var y = '50%';
            if (dot) {
              var r = dot.getBoundingClientRect();
              x = r.left + r.width / 2 + 'px';
              y = r.top + r.height / 2 + 'px';
            }
            field.style.setProperty('--wipe-x', x);
            field.style.setProperty('--wipe-y', y);
          }

          setWipeTarget();
          window.addEventListener('resize', setWipeTarget);

          document.documentElement.style.overflow = 'hidden';
          scan.setAttribute('aria-hidden', 'false');

          function showFrame(index) {
            frames.forEach(function (frame, idx) {
              var on = idx === index;
              frame.classList.toggle('is-on', on);
              frame.classList.remove('is-leaving');
              if (on && frame.hasAttribute('data-scan-final') && finalDot) {
                finalDot.classList.add('is-on');
              } else if (finalDot) {
                finalDot.classList.remove('is-on');
              }
            });
          }

          function finish() {
            setWipeTarget();
            field.classList.add('is-wiping');
            window.setTimeout(function () {
              var navDot = document.querySelector('.nav-dot');
              if (navDot) navDot.classList.add('is-landing');
            }, 420);
            window.setTimeout(function () {
              window.removeEventListener('resize', setWipeTarget);
              scan.classList.add('is-done');
              document.documentElement.classList.remove('has-recruiter-scan');
              document.documentElement.style.overflow = '';
              scan.setAttribute('aria-hidden', 'true');
              scan.remove();
              signalMotionReady();
            }, 720);
          }

          function advance() {
            var frame = frames[i];
            if (!frame) {
              finish();
              return;
            }
            var isFinal = frame.hasAttribute('data-scan-final');
            var hold = isFinal ? FINAL_HOLD : HOLD;

            window.setTimeout(function () {
              if (isFinal) {
                finish();
                return;
              }
              frame.classList.add('is-leaving');
              frame.classList.remove('is-on');
              i += 1;
              window.setTimeout(function () {
                showFrame(i);
                advance();
              }, SWAP);
            }, hold);
          }

          showFrame(0);
          advance();
          return true;
        }

        function navigateWithLeave(href) {
          if (leaving) return;
          if (reduce) {
            location.href = href;
            return;
          }
          leaving = true;
          try {
            sessionStorage.setItem('sl-page-enter', '1');
          } catch (e) {}
          document.body.classList.add('is-leaving');
          window.setTimeout(function () {
            location.href = href;
          }, 300);
        }

        /* bfcache restore can leave the page stuck faded out */
        window.addEventListener('pageshow', function () {
          leaving = false;
          document.body.classList.remove('is-leaving');
          document.documentElement.classList.remove('has-page-enter', 'is-page-entering');
        });

        function runPageEnter() {
          if (!document.documentElement.classList.contains('has-page-enter')) return false;
          if (reduce) {
            document.documentElement.classList.remove('has-page-enter');
            return false;
          }
          window.requestAnimationFrame(function () {
            window.requestAnimationFrame(function () {
              document.documentElement.classList.add('is-page-entering');
              window.setTimeout(function () {
                document.documentElement.classList.remove('has-page-enter', 'is-page-entering');
                signalMotionReady();
              }, 420);
            });
          });
          return true;
        }

        if (!runRecruiterScan()) {
          if (!runPageEnter()) signalMotionReady();
        }

        var replay = document.querySelector('[data-replay-scan]');
        if (replay) {
          replay.addEventListener('click', function () {
            try {
              sessionStorage.removeItem(SCAN_KEY);
            } catch (e) {}
            location.href = '/';
          });
        }

        function samePageSection(href) {
          try {
            var u = new URL(href, location.origin);
            if (u.origin !== location.origin) return null;
            var p = u.pathname.replace(/\/$/, '') || '/';
            var cur = location.pathname.replace(/\/$/, '') || '/';
            if (p !== cur) return null;
            if (u.hash === '#work' || u.hash === '#contact') return u.hash.slice(1);
            return null;
          } catch (e) {
            return null;
          }
        }

        function leaveTargets(href) {
          try {
            var u = new URL(href, location.origin);
            if (u.origin !== location.origin) return false;
            var p = u.pathname.replace(/\/$/, '') || '/';
            var cur = location.pathname.replace(/\/$/, '') || '/';
            if (p === cur) return false;
            return p === '/' || p === '/about' || p.indexOf('/work') === 0 || p.indexOf('/archive') === 0;
          } catch (e) {
            return false;
          }
        }

        document.querySelectorAll('a[href]').forEach(function (a) {
          a.addEventListener('click', function (e) {
            if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || a.target === '_blank') return;
            var href = a.getAttribute('href');
            if (!href || href.indexOf('mailto:') === 0) return;

            var section = samePageSection(href);
            if (section) {
              e.preventDefault();
              scrollToId(section, reduce ? 'auto' : 'smooth');
              history.replaceState(null, '', '#' + section);
              return;
            }

            if (!leaveTargets(href)) return;
            e.preventDefault();
            navigateWithLeave(a.href);
          });
        });

        var workLink = document.querySelector('[data-nav="work"]');
        var workSection = document.getElementById('work');
        if (workLink && workSection) {
          var setWorkActive = function (on) {
            workLink.classList.toggle('active', on);
          };
          if (location.hash === '#work') setWorkActive(true);
          var io = new IntersectionObserver(
            function (entries) {
              var entry = entries[0];
              setWorkActive(entry.isIntersecting && entry.intersectionRatio > 0.2);
            },
            { rootMargin: '-20% 0px -55% 0px', threshold: [0, 0.2, 0.4] },
          );
          io.observe(workSection);
        }
      })();
    </script>
  </body>
</html>
