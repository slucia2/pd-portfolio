---
import Base from './Base.astro';
import type { CaseStudy } from '../data/cases';
import { interstitialForSlug } from '../data/case-interstitial';

interface Props {
  case: CaseStudy;
  intro: string;
  meta: { key: string; value: string }[];
  /** Optional proof chips under the meta row (e.g. business owner, a11y). */
  credentials?: string[];
  heroAlt: string;
  problem: string;
  outcome: string;
  /** When true, skip the default problem/outcome opener (page owns that layout). */
  hideOpener?: boolean;
}

const { case: c, intro, meta, credentials = [], heroAlt, problem, outcome, hideOpener = false } =
  Astro.props;

const interstitial = interstitialForSlug(c.slug);
---
<Base
  title={`${c.title} · Sam Lucia`}
  description={intro}
  width="case"
  caseInterstitial={interstitial}
>
  <main
    class="case-main"
    style={`--accent:${c.accent};--accent-dark:${c.accentDark};--accent-tint:${c.accentTint};--accent-border:${c.accentBorder}`}
  >
    <a href="/" class="case-breadcrumb">◂ BACK TO HOME</a>
    <h1 class="case-title">{c.title}</h1>
    <p class="case-intro">{intro}</p>
    <div class="case-meta">
      {meta.map((m) => (
        <span class="case-meta-item">
          <span class="k">{m.key}</span>
          <span class="v">{m.value}</span>
        </span>
      ))}
    </div>
    {credentials.length > 0 && (
      <div class="case-creds" aria-label="Credentials">
        {credentials.map((chip) => (
          <span class="case-cred">{chip}</span>
        ))}
      </div>
    )}
    <div class="case-rule"></div>
    {!c.hideCaseHero && (
      c.heroVideo ? (
        <video
          class="case-hero"
          src={c.heroVideo}
          autoplay
          muted
          loop
          playsinline
          aria-label={heroAlt}
          style={[
            c.imagePosition ? `object-position:${c.imagePosition}` : '',
            c.imageFit === 'contain' ? 'height:auto;object-fit:contain;background:#fff' : '',
          ].filter(Boolean).join(';') || undefined}
        />
      ) : (
        <img
          src={c.image}
          alt={heroAlt}
          class="case-hero"
          style={[
            c.imagePosition ? `object-position:${c.imagePosition}` : '',
            c.imageFit === 'contain' ? 'height:auto;object-fit:contain;background:#fff' : '',
          ].filter(Boolean).join(';') || undefined}
        />
      )
    )}
    {!hideOpener && (
      <div class="case-opener">
        <div>
          <div class="sec-label">THE PROBLEM</div>
          <div class="sec-body" style="margin-top:0">{problem}</div>
        </div>
        <div>
          <div class="sec-label">THE OUTCOME</div>
          <div class="sec-body" style="margin-top:0">{outcome}</div>
        </div>
      </div>
    )}

    <slot />
  </main>
</Base>

<style>
  .case-creds {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 14px;
  }
  .case-cred {
    display: inline-flex;
    align-items: center;
    padding: 7px 12px;
    border-radius: 999px;
    border: 1px solid var(--accent-border);
    background: var(--accent-tint);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: .04em;
    color: var(--accent-dark);
  }
</style>
